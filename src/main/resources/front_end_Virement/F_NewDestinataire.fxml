<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>

<VBox alignment="CENTER" fillWidth="false" prefHeight="122.0" prefWidth="220.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="front_end.Virement.F_NewDestinataire_Controller">
   <children>
      <HBox prefHeight="100.0" prefWidth="200.0">
         <children>
            <VBox prefHeight="70.0" prefWidth="269.0">
               <children>
                  <Label text="Nom et Prénom" />
                  <Label text="IBAN">
                     <VBox.margin>
                        <Insets top="10.0" />
                     </VBox.margin>
                  </Label>
                  <Label text="BIC">
                     <VBox.margin>
                        <Insets top="10.0" />
                     </VBox.margin>
                  </Label>
               </children>
            </VBox>
            <VBox prefHeight="70.0" prefWidth="278.0">
               <children>
                  <TextField fx:id="NPField" />
                  <TextField fx:id="IBANField" />
                  <TextField fx:id="BICField" />
               </children>
            </VBox>
         </children>
         <VBox.margin>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </VBox.margin>
      </HBox>
      <HBox alignment="CENTER" prefHeight="48.0" prefWidth="200.0">
         <children>
            <Button mnemonicParsing="false" onAction="#btnNewDestOk" text="Ajouter" />
            <Rectangle arcHeight="1.0" arcWidth="1.0" fill="DODGERBLUE" height="25.0" opacity="0.0" stroke="BLACK" strokeType="INSIDE" width="50.0" />
            <Button mnemonicParsing="false" onAction="#btnClear" text="Clear" />
         </children>
         <opaqueInsets>
            <Insets />
         </opaqueInsets>
         <VBox.margin>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </VBox.margin>
      </HBox>
   </children>
</VBox>
