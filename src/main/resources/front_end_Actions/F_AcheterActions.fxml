<VBox alignment="TOP_CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="front_end_Authentification.Actions.AcheterActions_Controller">
   <children>
      <Label alignment="TOP_CENTER" prefHeight="53.0" prefWidth="319.0" text="Achat d'actions">
         <font>
            <Font size="36.0" />
