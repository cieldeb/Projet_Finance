      </Label>
      <HBox prefHeight="164.0" prefWidth="754.0">
         <children>
            <VBox alignment="TOP_CENTER" prefHeight="100.0" prefWidth="239.0">
               <children>
                  <TextField fx:id="searchField" prefHeight="25.0" prefWidth="186.0" />
                  <CheckBox fx:id="symboleCheckBox" alignment="TOP_LEFT" mnemonicParsing="false" text="Symbole" />
                  <CheckBox fx:id="valeurCheckBox" mnemonicParsing="false" text="Valeur Actuelle" />
                  <Button alignment="BOTTOM_CENTER" contentDisplay="RIGHT" mnemonicParsing="false" onAction="#chercherButton" text="Chercher" />
               </children>
            </VBox>
            <Separator orientation="VERTICAL" prefHeight="200.0" />
