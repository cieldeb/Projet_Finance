<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefHeight="406.0" prefWidth="603.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="front_end_Authentification.Accueil.F_Accueil_Controller">
   <children>
      <Label text="Accueil">
         <font>
            <Font size="36.0" />
         </font>
      </Label>
      <Separator prefWidth="200.0" />
      <Button alignment="CENTER" contentDisplay="CENTER" mnemonicParsing="false" onAction="#btnGererComptes" text="Gérer les comptes" />
      <Separator prefWidth="200.0" />
      <Label text="Portefeuilles">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <Separator prefWidth="200.0" />
      <HBox alignment="CENTER" prefHeight="66.0" prefWidth="603.0">
         <children>
            <Label text="Gérer un portefeuille : " />
            <ComboBox fx:id="portefeuilleComboBoxAffiche" onAction="#portefeuilleComboBox" prefWidth="150.0" promptText="Sélectionnez" />
         </children>
      </HBox>
      <Button mnemonicParsing="false" onAction="#creerPortefeuilleButton" text="Créer un portefeuille" />
   </children>
</VBox>
