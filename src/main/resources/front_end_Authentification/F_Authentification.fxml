<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER_LEFT" prefHeight="205.0" prefWidth="236.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="front_end.Authentification.F_Authentification_Controller">
   <children>
      <Label alignment="CENTER" contentDisplay="CENTER" prefHeight="21.0" prefWidth="274.0" text="Connexion">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <Label fx:id="idLB" text="Identifiant" />
      <TextField fx:id="idField" prefHeight="25.0" prefWidth="222.0" />
      <Label fx:id="mdpLB" text="Mot de passe" />
      <PasswordField fx:id="mdpField" />
      <VBox alignment="CENTER" prefHeight="97.0" prefWidth="215.0">
         <children>
            <Button fx:id="btnValid" mnemonicParsing="false" onAction="#btnValider" prefWidth="91.0" text="Valider">
               <VBox.margin>
                  <Insets bottom="10.0" />
               </VBox.margin></Button>
            <Button fx:id="btnNew" mnemonicParsing="false" onAction="#btnNoAccount" prefHeight="24.0" prefWidth="117.0" text="Je n'ai pas de compte" textFill="#867777">
               <font>
                  <Font size="10.0" />
               </font>
            </Button>
         </children>
      </VBox>
   </children>
   <padding>
      <Insets left="10.0" right="10.0" />
   </padding>
</VBox>
