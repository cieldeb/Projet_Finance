# Copy this file to ".env" and fill in your own API keys.
# ".env" is git-ignored and will never be committed.

# Alpha Vantage — used for stock (Actions) price lookups
# Get a free key at https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=your_alphavantage_key_here

# CoinGecko — used for crypto price lookups
# Get a free key at https://www.coingecko.com/en/api
COINGECKO_API_KEY=your_coingecko_key_here
